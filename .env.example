# ═══════════════════════════════════════════════════════════════
# PSPP v2.0: plantilla del archivo .env de la raíz (despliegue con Docker)
#
# QUIÉN LEE ESTE ARCHIVO: solo Docker Compose, para sustituir las ${VAR}
# de docker-compose.yml (desarrollo) y docker-compose.prod.yml (VPS). El
# backend no carga .env (no usa dotenv) y Vite no lee el .env de la raíz.
# Por eso una variable puesta aquí llega al código SOLO si el compose la
# pasa al contenedor. Cada variable lleva una de estas marcas, para
# docker-compose.prod.yml:
#   [VPS: se pasa]        el valor de aquí llega al backend o al build.
#   [VPS: fija]           el compose la fija con su propio valor; lo que
#                         se ponga aquí se ignora.
#   [VPS: no se pasa]     el compose no la pasa: en el VPS rige siempre su
#                         valor por omisión, se ponga lo que se ponga aquí.
#                         Sirve para el despliegue nativo y el de SEDATU.
#
# Otros despliegues usan sus propias plantillas, con las mismas variables:
#   nativo (systemd):      deploy/pspp.env.example
#   SEDATU (DGTIC):        deploy/pspp-sedatu.env.example
# Inventario y valores por omisión: README.md, sección "Variables de
# entorno". Las que dicen SECRETO hay que generarlas, nunca copiarlas.
#
# Son exactamente las variables que el código lee hoy: 25 del backend y
# 8 de la compilación del frontend.
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# Variables de EJECUCIÓN del backend (process.env; cambiarlas tiene
# efecto en el siguiente arranque del backend).
# ═══════════════════════════════════════════════════════════════

# ─── Base de datos ──────────────────────────────────────────────
# [VPS: fija] Host de PostgreSQL. El compose usa el servicio "postgres".
# DB_HOST=
# [VPS: se pasa] Puerto de PostgreSQL. Por omisión 5432.
DB_PORT=5432
# [VPS: se pasa] Obligatoria.
DB_NAME=pspp_db
# [VPS: se pasa] Obligatoria.
DB_USER=pspp_user
# [VPS: se pasa] Obligatoria. SECRETO.
DB_PASSWORD=cambiar_en_produccion

# ─── Sesión ─────────────────────────────────────────────────────
# [VPS: se pasa] Obligatoria. SECRETO. Firma los tokens de sesión y, por
# derivación (HMAC), los boletos de descarga: no hay una segunda clave.
# Sin ella el backend no arranca. Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar_por_secreto_generado_con_el_comando_de_arriba
# [VPS: se pasa] Vigencia del token por INACTIVIDAD, en horas: cada
# petición normal no la toca, pero el frontend llama a POST /auth/renovar
# cuando detecta actividad real de la persona (no polling de fondo ni la
# conexión de notificaciones) y eso reinicia este reloj. Por omisión 8.
JWT_INACTIVIDAD_HORAS=8
# [VPS: se pasa] Techo ABSOLUTO de la sesión, en horas, contado desde el
# inicio de sesión (login), no desde la última renovación: pasado este
# tiempo, /auth/renovar se niega aunque haya actividad, y hay que volver
# a entrar. Es lo que acota a un token robado — sin esto, quien lo tenga
# podría renovarlo indefinidamente. Por omisión 72.
JWT_SESION_MAX_HORAS=72
# [VPS: no se pasa] Vigencia, en segundos, del boleto efímero con el que
# el navegador descarga UN archivo (el token de sesión no viaja en URLs).
# Por omisión 60; tope 900.
BOLETO_ARCHIVO_TTL_SEGUNDOS=60

# ─── Superadministrador ─────────────────────────────────────────
# Cuenta que la plataforma asegura en CADA arranque, en todos los
# entornos: si no existe la crea, y si existe le reescribe la contraseña
# con lo que diga PASSWORD_USER. Es la puerta de entrada de una
# instalación nueva. Ojo al mudar de servidor: cambiar PASSWORD_USER
# cambia la contraseña de esa cuenta sin más aviso.
# [VPS: se pasa] Por omisión superadmin@example.org (ficticio).
SUPERADMIN_EMAIL=admin@example.org
# [VPS: no se pasa] Nombre visible. Por omisión "Usuario Administrador".
SUPERADMIN_NOMBRE=
# [VPS: se pasa] SECRETO. Vacía = no se crea ni actualiza la cuenta (no
# hay con qué entrar la primera vez).
PASSWORD_USER=cambiar_en_produccion

# ─── Almacén de objetos (MinIO o S3-compatible) ─────────────────
# [VPS: fija] Host del almacén. El compose usa el servicio "minio".
# Por omisión en el código: "minio".
# MINIO_ENDPOINT=
# [VPS: se pasa] Puerto. Por omisión 9000.
MINIO_PORT=9000
# [VPS: fija] "true" para HTTPS; cualquier otro valor = HTTP. El compose
# fija "false".
# MINIO_USE_SSL=
# [VPS: se pasa] Usuario o access key. Obligatoria. En el VPS también es
# el usuario raíz del contenedor MinIO. SECRETO (credencial).
MINIO_USER=pspp_admin
# [VPS: se pasa] Contraseña o secret key. Obligatoria. SECRETO.
MINIO_PASSWORD=cambiar_en_produccion
# [VPS: se pasa] Bucket. Por omisión pspp-evidencias.
MINIO_BUCKET=pspp-evidencias
# [VPS: no se pasa] Prefijo que se antepone a TODA clave de objeto (al
# escribir, leer, copiar y borrar) para separar ambientes en un mismo
# bucket: "qa" → qa/evidencias/... Vacío = sin prefijo, como siempre. La
# BD guarda la clave sin prefijo. El VPS no usa prefijo a propósito.
MINIO_PREFIX=

# ─── Subida de archivos ─────────────────────────────────────────
# [VPS: no se pasa] Carpeta del temporal de cada subida (se borra
# siempre). Por omisión <tmp del sistema>/pspp-uploads.
UPLOAD_TMP_DIR=
# [VPS: no se pasa] Tamaño máximo por archivo, en MB. Por omisión 200. Si
# se cambia, mover también VITE_UPLOAD_MAX_SIZE_MB y client_max_body_size
# de nginx (UPLOAD_MAX_SIZE_MB + 10). Ver deploy/README.md, sección 12.
UPLOAD_MAX_SIZE_MB=200
# [VPS: no se pasa] Tiempo máximo para que el backend RECIBA una petición
# completa, en segundos (Node corta a 300 si no se fija). Por omisión 3600.
TIEMPO_MAXIMO_PETICION_SEGUNDOS=3600

# ─── Servidor ───────────────────────────────────────────────────
# [VPS: fija] "production" apaga los datos de demostración; "development"
# agrega el stack de los errores a las respuestas. El compose de
# producción fija "production" y el de desarrollo "development".
# NODE_ENV=
# [VPS: fija] Puerto donde escucha el backend. Por omisión 3000; el
# compose fija 3000.
# PORT=
# [VPS: se pasa] Obligatoria en producción. URL pública del frontend, con
# protocolo (y con su ruta si se sirve bajo un subdirectorio). Controla
# CORS (se compara contra su origen) y las ligas de activación e
# invitación. Por omisión http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════
# Variables de COMPILACIÓN del frontend (Vite las lee solo durante
# "npm run build"; cambiarlas después no tiene efecto sobre un dist/ ya
# generado: hay que recompilar).
# ═══════════════════════════════════════════════════════════════

# [VPS: fija] A dónde llama el frontend a la API. Por omisión /api/v1
# (ruta relativa: el mismo build sirve en cualquier dominio). El compose
# de producción fija /api/v1.
VITE_API_URL=
# [VPS: no se pasa] Ruta base donde se publica el frontend, con ambas
# diagonales (/pspp/). Por omisión /.
VITE_BASE_PATH=
# [VPS: se pasa] Llave de CARTO para los mapas base. Vacía = el mapa base
# no carga; el resto funciona. No es secreta: queda dentro del JavaScript
# que descarga cualquier navegador.
VITE_CARTO_API_KEY=

# Límites del cliente HTTP (frontend/src/api/limites.js). Todos
# [VPS: no se pasa]: en el VPS rigen siempre sus valores por omisión.
# Peticiones normales (ms). Por omisión 30000.
VITE_TIEMPO_ESPERA_MS=
# Exportar, duplicar, previsualizar/confirmar importación (ms). Por
# omisión 300000 (= proxy_read_timeout de nginx).
VITE_TIEMPO_ESPERA_PROCESO_MS=
# Subidas/descargas: se cancelan si dejan de avanzar este tiempo (ms). Por
# omisión 60000 (= client_body_timeout de nginx).
VITE_TRANSFERENCIA_SIN_AVANCE_MS=
# Tope total de una transferencia (ms). Por omisión 3600000 (=
# TIEMPO_MAXIMO_PETICION_SEGUNDOS).
VITE_TIEMPO_MAXIMO_TRANSFERENCIA_MS=
# Tamaño máximo de archivo, en MB, que el navegador deja subir. Por
# omisión 200 (= UPLOAD_MAX_SIZE_MB).
VITE_UPLOAD_MAX_SIZE_MB=
