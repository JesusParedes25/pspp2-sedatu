# ═══════════════════════════════════════════════════════════════
# Variables de EJECUCIÓN del backend (las lee process.env en tiempo de
# arranque/petición; cambiarlas sin reconstruir nada tiene efecto en el
# siguiente arranque del backend).
# ═══════════════════════════════════════════════════════════════

# ─── Base de datos ──────────────────────────────────────────────
DB_NAME=pspp_db
DB_USER=pspp_user
DB_PASSWORD=cambiar_en_produccion
# Puerto interno de PostgreSQL. Lo usa docker-compose.prod.yml; salvo que
# haya un motivo, se deja en 5432.
DB_PORT=5432

# ─── JWT ────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar_por_secreto_generado_con_el_comando_de_arriba
# Duración de la sesión. Si se deja vacío o se quita la línea, el backend
# usa 48h por omisión (ver auth.controller.js).
JWT_EXPIRES_IN=48h
# Vigencia, en segundos, del boleto efímero con el que el navegador abre o
# descarga UN archivo (el token de sesión ya no viaja en ninguna URL). Si
# se deja vacío, 60. Tope de 900 (15 min) aunque se ponga más.
BOLETO_ARCHIVO_TTL_SEGUNDOS=60

# ─── Superadministrador ─────────────────────────────────────────
# Cuenta que la plataforma asegura en CADA arranque, en todos los
# entornos: si no existe la crea, y si existe le reescribe la contraseña
# con lo que diga PASSWORD_USER. Es la puerta de entrada de una
# instalación nueva — sin esto no hay con qué iniciar sesión la primera
# vez. Ojo al mudar de servidor: cambiar PASSWORD_USER cambia la
# contraseña de esa cuenta sin más aviso.
SUPERADMIN_EMAIL=admin@example.org
PASSWORD_USER=cambiar_en_produccion

# ─── MinIO ──────────────────────────────────────────────────────
MINIO_USER=pspp_admin
MINIO_PASSWORD=cambiar_en_produccion
MINIO_BUCKET=pspp-evidencias
MINIO_PORT=9000
# Prefijo que el backend antepone a TODA clave de objeto (al escribir, leer,
# copiar y borrar) para separar ambientes dentro de un mismo bucket, p. ej.
# "qa" → los archivos quedan en qa/evidencias/... Vacío o ausente = sin
# prefijo, exactamente como hasta ahora (lo ya almacenado se sigue
# encontrando). La BD guarda siempre la clave sin prefijo.
# OJO: docker-compose.prod.yml no pasa esta variable al contenedor a
# propósito (el VPS actual no usa prefijo); la usa el modelo SEDATU
# (deploy/docker-compose.sedatu.yml) y el despliegue nativo.
MINIO_PREFIX=

# ─── Subida de archivos ─────────────────────────────────────────
# El backend escribe cada archivo subido a un temporal en este
# directorio mientras lo manda a MinIO (en vez de guardarlo completo en
# RAM); lo borra siempre al terminar. Si se deja vacío, usa una carpeta
# "pspp-uploads" dentro del directorio temporal del sistema operativo.
UPLOAD_TMP_DIR=
# Tamaño máximo por archivo, en MB, para todas las rutas que suben a
# MinIO (evidencias, imagen de proyecto, reemplazo de shapefile). Si se
# deja vacío, usa 200. Tiene que coincidir con client_max_body_size de
# nginx, o las subidas grandes fallan con un error que no menciona esta
# variable.
UPLOAD_MAX_SIZE_MB=200
# Tiempo máximo, en segundos, para que el backend RECIBA una petición
# completa (cabeceras + cuerpo). Node corta a los 300 s por omisión, y con
# nginx en `proxy_request_buffering off` el cuerpo de una subida llega al
# ritmo del usuario: una subida lenta de 200 MB moría ahí. Si se deja
# vacío, 3600 (60 min), alineado con VITE_TIEMPO_MAXIMO_TRANSFERENCIA_MS.
TIEMPO_MAXIMO_PETICION_SEGUNDOS=3600

# ─── Frontend (uso del backend, no de compilación) ──────────────
# URL pública donde vive el frontend. Se usa para construir links de
# invitación/activación de cuenta (?token=...) enviados por correo o
# copiados manualmente, Y para la lista blanca de CORS (server.js) — si
# no coincide con la URL real, el navegador bloquea todas las
# peticiones del frontend a la API. En desarrollo: http://localhost:5173
# En producción: la URL real del dominio (ej. https://pspp.geobint.com) —
# si se deja vacío, el backend cae a localhost:5173.
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════
# Variables de COMPILACIÓN del frontend (Vite las lee solo durante
# "npm run build"; cambiarlas después de compilar no tiene ningún
# efecto sobre un dist/ ya generado — hay que recompilar).
# ═══════════════════════════════════════════════════════════════

# A dónde apunta el frontend compilado para llamar a la API. Por
# omisión es la ruta relativa /api/v1 (ver frontend/src/api/client.js):
# con ese valor, el mismo build funciona en cualquier dominio sin
# recompilar, porque quien resuelve a dónde va realmente /api/v1 es
# nginx, no el frontend. Solo hace falta definirla si el backend vive
# en un dominio distinto al del frontend.
VITE_API_URL=

# CARTO dejó de servir basemaps.cartocdn.com sin autenticación (empezó a
# responder 403). Generar una API key gratuita en carto.com (Dashboard >
# Developers > API Keys) y ponerla aquí. Si se deja vacía, el mapa base
# simplemente no carga hasta que se configure, el resto de la
# plataforma sigue funcionando igual.
VITE_CARTO_API_KEY=

# Límites del cliente HTTP del navegador (frontend/src/api/limites.js).
# Vacíos = valores por omisión indicados. Ver deploy/README.md, sección 12,
# para cómo encajan con nginx y el backend.
# Peticiones normales (ms). Por omisión 30000.
VITE_TIEMPO_ESPERA_MS=
# Operaciones en que el servidor procesa antes de contestar: exportar,
# duplicar, previsualizar/confirmar importación (ms). Por omisión 300000,
# igual al proxy_read_timeout de nginx.
VITE_TIEMPO_ESPERA_PROCESO_MS=
# Subidas y descargas grandes: se cancelan si dejan de avanzar este tiempo
# (ms). Por omisión 60000, igual al client_body_timeout de nginx.
VITE_TRANSFERENCIA_SIN_AVANCE_MS=
# Tope total de una transferencia (ms). Por omisión 3600000 (60 min),
# igual a TIEMPO_MAXIMO_PETICION_SEGUNDOS del backend.
VITE_TIEMPO_MAXIMO_TRANSFERENCIA_MS=
# Tamaño máximo de un archivo, en MB: el navegador rechaza antes de subir
# lo que el servidor rechazaría al final. Debe coincidir con
# UPLOAD_MAX_SIZE_MB y client_max_body_size. Por omisión 200.
VITE_UPLOAD_MAX_SIZE_MB=
