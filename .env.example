# ─── Base de datos ──────────────────────────────────────────────
DB_NAME=pspp_db
DB_USER=pspp_user
DB_PASSWORD=cambiar_en_produccion
# Puerto interno de PostgreSQL. Lo usa docker-compose.prod.yml; salvo que
# haya un motivo, se deja en 5432.
DB_PORT=5432

# ─── JWT ────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar_por_secreto_generado_con_el_comando_de_arriba
JWT_EXPIRES_IN=8h

# ─── Superadministrador ─────────────────────────────────────────
# Cuenta que la plataforma asegura en CADA arranque, en todos los
# entornos: si no existe la crea, y si existe le reescribe la contraseña
# con lo que diga PASSWORD_USER. Es la puerta de entrada de una
# instalación nueva — sin esto no hay con qué iniciar sesión la primera
# vez. Ojo al mudar de servidor: cambiar PASSWORD_USER cambia la
# contraseña de esa cuenta sin más aviso.
SUPERADMIN_EMAIL=admin@sedatu.gob.mx
PASSWORD_USER=cambiar_en_produccion

# ─── MinIO ──────────────────────────────────────────────────────
MINIO_USER=pspp_admin
MINIO_PASSWORD=cambiar_en_produccion
MINIO_BUCKET=pspp-evidencias
MINIO_PORT=9000

# ─── GeoServer ──────────────────────────────────────────────────
# docker-compose.yml (desarrollo) usa GEOSERVER_USER/GEOSERVER_PASSWORD;
# docker-compose.prod.yml usa GEOSERVER_ADMIN_PASSWORD. Se dejan las tres
# para que el mismo archivo sirva en ambos entornos.
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=cambiar_en_produccion
GEOSERVER_ADMIN_PASSWORD=cambiar_en_produccion

# ─── Frontend ───────────────────────────────────────────────────
# URL pública donde vive el frontend. Se usa para construir links de
# invitación/activación de cuenta (?token=...) enviados por correo o
# copiados manualmente. En desarrollo: http://localhost:5173
# En producción: la URL real del dominio (ej. https://daot.geobint.com) —
# si se deja vacío, el backend cae a localhost:5173 y los links de
# activación quedarán rotos para cualquiera fuera de esa máquina.
FRONTEND_URL=http://localhost:5173

# ─── SMTP (dejar vacío si no está configurado aún) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sedatu.gob.mx
