# PSPP v2.0: plantilla del EnvironmentFile de systemd (despliegue nativo)
#
# El backend NO usa dotenv (se verificó: no hay ninguna carga de .env en
# el código, backend/package.json no tiene la dependencia). Lee las
# variables directo de process.env. En Docker las inyectaba
# docker-compose.prod.yml; aquí las inyecta systemd a través de
# EnvironmentFile= en pspp-backend.service.
#
# Copiar a /etc/pspp/pspp.env, llenar los valores, y:
#   chown root:pspp /etc/pspp/pspp.env
#   chmod 640 /etc/pspp/pspp.env
# (el usuario de servicio "pspp" solo necesita leerlo, nunca escribirlo)
#
# Estas son exactamente las 25 variables que el backend lee hoy
# (verificado con un grep de process.env.* sobre todo backend/src).
# Ninguna otra variable tiene efecto en el backend. Las 8 variables de
# COMPILACIÓN del frontend no van en este archivo (systemd no compila
# nada): se pasan a `npm run build`. Están listadas al final, como
# referencia.

# ─── Base de datos (backend/src/db/pool.js) ─────────────────────
# DB_HOST: host de PostgreSQL. Obligatoria.
DB_HOST=
# DB_PORT: puerto de PostgreSQL. Opcional: si se deja vacía, pg usa su
# propio valor por omisión (5432); el código no fija uno explícito.
DB_PORT=5432
# DB_NAME: nombre de la base de datos. Obligatoria.
DB_NAME=
# DB_USER: usuario de PostgreSQL. Obligatoria.
DB_USER=
# DB_PASSWORD: contraseña de ese usuario. Obligatoria. Secreto.
DB_PASSWORD=

# ─── JWT (backend/src/controllers/auth.controller.js,
#          backend/src/middleware/auth.middleware.js) ───────────
# JWT_SECRET: firma y verifica los tokens de sesión y, por derivación
# (HMAC-SHA256 con una etiqueta fija), los boletos de descarga: no hay una
# segunda clave que configurar. Obligatoria. Secreto. Sin ella el backend
# se niega a arrancar y lo dice en el log (journalctl -u pspp-backend).
# Cambiarla cierra todas las sesiones y anula los boletos vigentes.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# JWT_INACTIVIDAD_HORAS: vigencia del token por INACTIVIDAD, en horas.
# Cada petición normal no la toca; el frontend llama a POST /auth/renovar
# cuando detecta actividad real de la persona (nunca el polling de fondo
# ni la conexión de notificaciones en tiempo real) y eso reinicia este
# reloj. Opcional, por omisión 8. La DGTIC recomendó 15 minutos; se fijó
# 8h porque la captura en PSPP se hace en sesiones largas.
JWT_INACTIVIDAD_HORAS=8
# JWT_SESION_MAX_HORAS: techo ABSOLUTO de la sesión, en horas, contado
# desde el login — no desde la última renovación. Pasado este tiempo,
# POST /auth/renovar se niega aunque haya actividad, y hay que volver a
# entrar. Es lo que acota a un token robado: sin este techo, quien lo
# tenga podría renovarlo indefinidamente. Opcional, por omisión 72.
JWT_SESION_MAX_HORAS=72
# BOLETO_ARCHIVO_TTL_SEGUNDOS: vigencia, en segundos, del boleto efímero
# (backend/src/utils/boletoArchivo.js) con el que el navegador descarga un
# archivo. Opcional, por omisión 60; valores inválidos vuelven a 60 y hay
# un tope de 900. El boleto queda ligado a la persona, al archivo y a la
# acción (ver/descargar), y se firma con una clave derivada de JWT_SECRET,
# así que no sirve como sesión ni la sesión sirve como boleto. Existe para
# que el token de sesión no quede escrito en las bitácoras de los proxies
# que registran URLs. Solo se valida al EMPEZAR la descarga: una descarga
# larga termina aunque el boleto caduque a la mitad.
BOLETO_ARCHIVO_TTL_SEGUNDOS=60

# ─── MinIO / almacenamiento S3-compatible (backend/src/utils/minio.js) ──
# MINIO_ENDPOINT: host del almacenamiento de archivos. Obligatoria en la
# práctica: el valor por omisión del código ("minio") es el nombre del
# servicio dentro de la red de Docker y no significa nada fuera de ahí.
MINIO_ENDPOINT=
# MINIO_PORT: puerto del almacenamiento. Opcional, por omisión 9000.
MINIO_PORT=9000
# MINIO_USER: usuario/access key del almacenamiento. Obligatoria.
MINIO_USER=
# MINIO_PASSWORD: contraseña/secret key del almacenamiento. Obligatoria.
# Secreto.
MINIO_PASSWORD=
# MINIO_BUCKET: nombre del bucket de evidencias. Opcional, por omisión
# "pspp-evidencias" (el bucket se crea solo si no existe).
MINIO_BUCKET=pspp-evidencias
# MINIO_PREFIX: prefijo que el backend antepone a TODA clave de objeto,
# al escribir, leer, copiar y borrar. Opcional. Sirve para separar
# ambientes dentro de un solo bucket (la DGTIC asigna uno por proyecto):
# con MINIO_PREFIX=qa una evidencia queda en "qa/evidencias/...", con
# MINIO_PREFIX=prod en "prod/evidencias/...". Vacío o ausente = sin
# prefijo, comportamiento idéntico al de siempre, y lo ya almacenado se
# sigue encontrando. La base de datos guarda siempre la clave SIN prefijo,
# así que un respaldo de QA restaurado en producción no requiere
# reescribir filas, pero sí que los objetos estén bajo el prefijo del
# ambiente destino (ver deploy/README.md, migración de archivos). No
# puede contener "..": el backend se niega a arrancar si lo trae.
MINIO_PREFIX=
# MINIO_USE_SSL: si hablarle al almacenamiento por HTTPS. Opcional. El
# código compara contra el texto exacto "true"; cualquier otro valor,
# incluida esta línea vacía, se trata como false.
MINIO_USE_SSL=false

# ─── Subida de archivos (backend/src/middleware/subidaArchivo.middleware.js) ──
# UPLOAD_MAX_SIZE_MB: tamaño máximo por archivo, en MB, para evidencias/
# imagen de proyecto/shapefile. Opcional, por omisión 200.
# IMPORTANTE: tiene que coincidir con client_max_body_size de
# deploy/nginx/pspp.conf. Si nginx tiene un límite más chico, rechaza la
# subida antes de que el backend la vea, con un error 413 que no
# menciona esta variable en ningún lado — el síntoma es confuso si no se
# sabe que los dos límites tienen que coincidir.
UPLOAD_MAX_SIZE_MB=200
# TIEMPO_MAXIMO_PETICION_SEGUNDOS: tiempo máximo para que el backend
# reciba una petición completa (server.requestTimeout de Node). Opcional,
# por omisión 3600. Node trae 300 s, y como deploy/nginx/pspp.conf usa
# `proxy_request_buffering off` (la subida llega al backend al ritmo del
# usuario, sin copia en el disco de nginx), una subida de más de 5 min
# moría con 408 aunque nginx y el navegador la aceptaran. Debe ser igual o
# mayor que VITE_TIEMPO_MAXIMO_TRANSFERENCIA_MS del frontend (60 min).
TIEMPO_MAXIMO_PETICION_SEGUNDOS=3600
# UPLOAD_TMP_DIR: carpeta donde el backend escribe el temporal de cada
# archivo subido antes de mandarlo al almacenamiento (lo borra siempre
# al terminar). Opcional en el código (por omisión usa una carpeta
# dentro del directorio temporal del sistema operativo), pero en este
# despliegue hay que fijarla a una ruta dentro de /var/lib/pspp: es la
# única ruta que pspp-backend.service declara escribible
# (ReadWritePaths=/var/lib/pspp bajo ProtectSystem=full). Crear la
# carpeta antes de arrancar el servicio (ver deploy/README.md).
UPLOAD_TMP_DIR=/var/lib/pspp/uploads-tmp

# ─── Superadministrador (backend/src/db/seeders/00_superadmin.js) ──
# Esta cuenta se asegura en CADA arranque del backend, sin importar el
# entorno: si no existe la crea, y si existe le REESCRIBE la contraseña
# con lo que diga PASSWORD_USER. Cada reinicio del servicio restablece
# esa contraseña al valor de aquí.
# SUPERADMIN_EMAIL: correo de esa cuenta. Opcional (tiene un valor
# ficticio por omisión en el código), pero se recomienda fijarlo.
SUPERADMIN_EMAIL=
# SUPERADMIN_NOMBRE: nombre de esa cuenta. Opcional (ficticio por
# omisión en el código).
SUPERADMIN_NOMBRE=
# PASSWORD_USER: contraseña en texto plano de esa cuenta (se hashea con
# bcrypt antes de guardarse). Si se deja vacía, el backend arranca igual
# pero no crea ni actualiza al superadmin — no hay con qué entrar la
# primera vez. En la práctica, obligatoria. Secreto.
PASSWORD_USER=

# ─── Servidor (backend/src/server.js) ───────────────────────────
# PORT: puerto donde escucha el backend. El código usa 3000 por
# omisión, pero AQUÍ debe ser 3100: deploy/nginx/pspp.conf y
# pspp-backend.service (vía ReadWritePaths, no afecta el puerto, pero el
# nginx.conf entregado asume este puerto en su proxy_pass) ya están
# escritos para 3100. Si se cambia aquí, cambiar también proxy_pass en
# deploy/nginx/pspp.conf.
PORT=3100
# NODE_ENV: debe ser literalmente "production". Apaga los seeders de
# datos de demostración y los stack traces de error en las respuestas.
NODE_ENV=production
# FRONTEND_URL: URL pública completa (con protocolo) desde donde se
# sirve el frontend, con su ruta si se publica bajo un subdirectorio
# (https://sistemas.sedatu.gob.mx/pspp). Controla dos cosas: la lista
# blanca de CORS (server.js compara el Origin de cada petición contra el
# ORIGEN de este valor: esquema + host + puerto) y las ligas de
# activación/invitación de cuenta que el backend construye con la URL
# completa. Si no coincide con la URL real, el navegador bloquea todas
# las peticiones del frontend a la API (las ve como de otro origen), sin
# que el backend se entere de que algo está mal — el síntoma es que la
# aplicación deja de funcionar para todo el mundo, no un error puntual.
FRONTEND_URL=

# ═══════════════════════════════════════════════════════════════
# REFERENCIA: variables de compilación del frontend. NO se ponen en este
# archivo; se pasan al compilar, p. ej.:
#   cd /opt/pspp/frontend && sudo -u pspp env VITE_CARTO_API_KEY=... npm run build
# Vacías o ausentes = valor por omisión. Ver frontend/src/api/limites.js y
# deploy/README.md (secciones 5 y 12).
#
#   VITE_API_URL                         ruta de la API (por omisión /api/v1)
#   VITE_BASE_PATH                       ruta base del frontend (por omisión /)
#   VITE_CARTO_API_KEY                   llave de mapas base (sin valor: no carga el mapa base)
#   VITE_TIEMPO_ESPERA_MS                peticiones normales (por omisión 30000)
#   VITE_TIEMPO_ESPERA_PROCESO_MS        exportar/duplicar/importar (por omisión 300000)
#   VITE_TRANSFERENCIA_SIN_AVANCE_MS     subidas/descargas sin avance (por omisión 60000)
#   VITE_TIEMPO_MAXIMO_TRANSFERENCIA_MS  tope de una transferencia (por omisión 3600000)
#   VITE_UPLOAD_MAX_SIZE_MB              tamaño máximo de archivo (por omisión 200)
# ═══════════════════════════════════════════════════════════════
