# PSPP v2.0: variables para deploy/docker-compose.sedatu.yml (modelo SEDATU)
#
# Copiar FUERA del repositorio, llenar y proteger:
#   install -d -m 750 /etc/pspp
#   cp deploy/pspp-sedatu.env.example /etc/pspp/pspp-sedatu.env
#   chmod 600 /etc/pspp/pspp-sedatu.env
# y pasarlo con --env-file en cada comando de compose (ver deploy/README.md).
# Si el pipeline de la DGTIC inyecta las variables por su cuenta (secretos
# del CI, bóveda), este archivo no hace falta: compose las toma del
# entorno del proceso.
#
# El detalle de cada variable del backend está en deploy/pspp.env.example;
# aquí solo se anota lo que cambia en este modelo. Las marcadas
# OBLIGATORIA hacen que compose se niegue a arrancar si faltan.

# ─── Publicación (solo compose, no las lee el backend) ──────────
# Puerto del servidor asignado por la DGTIC. OBLIGATORIA. Es el único
# puerto que se publica; el nginx institucional hace proxy hacia él.
PSPP_PUERTO=
# Interfaz donde se publica. Por omisión 127.0.0.1 (nginx en el mismo
# servidor). Solo cambiar si el nginx institucional está en otro equipo.
PSPP_BIND_IP=127.0.0.1
# Nombre:etiqueta de la imagen. Por omisión pspp-backend:sedatu (se
# construye localmente). Si la DGTIC publica la imagen en su registro,
# poner aquí la referencia completa.
PSPP_IMAGEN=

# ─── Base de datos (externa, PostgreSQL 15 + PostGIS) ───────────
# Si escucha en el mismo servidor, usar host.docker.internal (dentro del
# contenedor, 127.0.0.1 es el contenedor). OBLIGATORIAS salvo DB_PORT.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── Sesión ─────────────────────────────────────────────────────
# OBLIGATORIA. Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=48h

# ─── Almacén de objetos (externo, S3-compatible) ────────────────
# Servicio interno: el navegador nunca habla con él, todo archivo pasa por
# el backend. OBLIGATORIAS salvo puerto/SSL/prefijo.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=
MINIO_PASSWORD=
# El bucket que asignó la DGTIC al proyecto (uno solo para QA y prod).
MINIO_BUCKET=
# Separa ambientes dentro de ese bucket: "qa" en QA, "prod" en producción.
MINIO_PREFIX=

# ─── Frontend ───────────────────────────────────────────────────
# URL pública del frontend, con protocolo y, si aplica, con su ruta
# (p. ej. https://sistemas.sedatu.gob.mx/pspp). OBLIGATORIA. CORS compara
# contra su origen (esquema + host + puerto) y las ligas de activación se
# arman con la URL completa.
FRONTEND_URL=

# ─── Subidas ────────────────────────────────────────────────────
# Debe coincidir con client_max_body_size del nginx institucional.
UPLOAD_MAX_SIZE_MB=200

# ─── Superadministrador (se asegura y se le reescribe la contraseña en
# cada arranque; ver deploy/pspp.env.example) ────────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_NOMBRE=
PASSWORD_USER=
